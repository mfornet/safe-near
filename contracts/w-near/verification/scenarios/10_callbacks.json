        {"label": "r1", "deliver": "t1#1", "results": ["failed"], "expect": "ok"}
      ]},
      {"receipts": [
        {"label": "check", "call": {"method": "ft_total_supply"}, "expect": "ok"}
      ]}
    ]
  },
