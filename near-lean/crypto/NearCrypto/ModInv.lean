import NearCrypto.Bytes

/-!
# Inversion modulo an odd 256-bit number

Generated by `scripts/gen_modinv.py`; see there for the construction. `inv a m` is the inverse of
`a` modulo the odd `m < 2²⁵⁶` (`0` when `a` is `0` modulo `m` or the inverse does not exist),
about ten times faster than the extended Euclidean algorithm on `Nat`, which allocates a number
per step. The result is checked (`a · inv a ≡ 1`) and recomputed by the `Nat` algorithm should the
check ever fail, so the answer never depends on the limb code alone.
-/

namespace NearCrypto.ModInv

/-- The extended Euclidean algorithm on `Nat`: the reference. -/
def invEuclid (a m : Nat) : Nat :=
  let rec go : Nat → Nat → Nat → Int → Int → Nat
    | 0, _, _, _, _ => 0
    | fuel + 1, r0, r1, t0, t1 =>
      if r1 == 0 then (if r0 == 1 then (t0 % (m : Int)).toNat else 0)
      else
        let q := r0 / r1
        go fuel r1 (r0 - q * r1) t1 (t0 - (q : Int) * t1)
  go 600 m (a % m) 0 1

/-- The loop; `none` when the fuel runs out (it cannot, for operands below `2²⁵⁶`). -/
private def go (fuel : Nat) (m0 m1 m2 m3 u0 u1 u2 u3 v0 v1 v2 v3 x0 x1 x2 x3 y0 y1 y2 y3 : UInt64) :
    Option (UInt64 × UInt64 × UInt64 × UInt64) :=
  match fuel with
  | 0 => none
  | fuel + 1 =>
    if u0 == 1 && (u1 ||| u2 ||| u3) == 0 then some (x0, x1, x2, x3)
    else
      if v0 == 1 && (v1 ||| v2 ||| v3) == 0 then some (y0, y1, y2, y3)
      else
        if u0 &&& 1 == 0 then
          let nu0 := (u0 >>> 1) ||| (u1 <<< 63)
          let nu1 := (u1 >>> 1) ||| (u2 <<< 63)
          let nu2 := (u2 >>> 1) ||| (u3 <<< 63)
          let nu3 := u3 >>> 1
          let hxmask : UInt64 := 0 - (x0 &&& 1)
          let hxa0 := m0 &&& hxmask
          let hxa1 := m1 &&& hxmask
          let hxa2 := m2 &&& hxmask
          let hxa3 := m3 &&& hxmask
          let hxs0 := x0 + hxa0
          let hxc0 : UInt64 := if hxs0 < x0 then 1 else 0
          let hxt1 := x1 + hxa1
          let hxs1 := hxt1 + hxc0
          let hxc1 : UInt64 := if hxt1 < x1 || hxs1 < hxt1 then 1 else 0
          let hxt2 := x2 + hxa2
          let hxs2 := hxt2 + hxc1
          let hxc2 : UInt64 := if hxt2 < x2 || hxs2 < hxt2 then 1 else 0
          let hxt3 := x3 + hxa3
          let hxs3 := hxt3 + hxc2
          let hxc3 : UInt64 := if hxt3 < x3 || hxs3 < hxt3 then 1 else 0
          let hx0 := (hxs0 >>> 1) ||| (hxs1 <<< 63)
          let hx1 := (hxs1 >>> 1) ||| (hxs2 <<< 63)
          let hx2 := (hxs2 >>> 1) ||| (hxs3 <<< 63)
          let hx3 := (hxs3 >>> 1) ||| (hxc3 <<< 63)
          go fuel m0 m1 m2 m3 nu0 nu1 nu2 nu3 v0 v1 v2 v3 hx0 hx1 hx2 hx3 y0 y1 y2 y3
        else
          if v0 &&& 1 == 0 then
            let nv0 := (v0 >>> 1) ||| (v1 <<< 63)
            let nv1 := (v1 >>> 1) ||| (v2 <<< 63)
            let nv2 := (v2 >>> 1) ||| (v3 <<< 63)
            let nv3 := v3 >>> 1
            let hymask : UInt64 := 0 - (y0 &&& 1)
            let hya0 := m0 &&& hymask
            let hya1 := m1 &&& hymask
            let hya2 := m2 &&& hymask
            let hya3 := m3 &&& hymask
            let hys0 := y0 + hya0
            let hyc0 : UInt64 := if hys0 < y0 then 1 else 0
            let hyt1 := y1 + hya1
            let hys1 := hyt1 + hyc0
            let hyc1 : UInt64 := if hyt1 < y1 || hys1 < hyt1 then 1 else 0
            let hyt2 := y2 + hya2
            let hys2 := hyt2 + hyc1
            let hyc2 : UInt64 := if hyt2 < y2 || hys2 < hyt2 then 1 else 0
            let hyt3 := y3 + hya3
            let hys3 := hyt3 + hyc2
            let hyc3 : UInt64 := if hyt3 < y3 || hys3 < hyt3 then 1 else 0
            let hy0 := (hys0 >>> 1) ||| (hys1 <<< 63)
            let hy1 := (hys1 >>> 1) ||| (hys2 <<< 63)
            let hy2 := (hys2 >>> 1) ||| (hys3 <<< 63)
            let hy3 := (hys3 >>> 1) ||| (hyc3 <<< 63)
            go fuel m0 m1 m2 m3 u0 u1 u2 u3 nv0 nv1 nv2 nv3 x0 x1 x2 x3 hy0 hy1 hy2 hy3
          else
            let d0 := u0 - v0
            let geb0 : UInt64 := if u0 < v0 then 1 else 0
            let get1 := u1 - v1
            let d1 := get1 - geb0
            let geb1 : UInt64 := if u1 < v1 || get1 < geb0 then 1 else 0
            let get2 := u2 - v2
            let d2 := get2 - geb1
            let geb2 : UInt64 := if u2 < v2 || get2 < geb1 then 1 else 0
            let get3 := u3 - v3
            let d3 := get3 - geb2
            let geb3 : UInt64 := if u3 < v3 || get3 < geb2 then 1 else 0
            if geb3 == 0 then
              let e0 := x0 - y0
              let exb0 : UInt64 := if x0 < y0 then 1 else 0
              let ext1 := x1 - y1
              let e1 := ext1 - exb0
              let exb1 : UInt64 := if x1 < y1 || ext1 < exb0 then 1 else 0
              let ext2 := x2 - y2
              let e2 := ext2 - exb1
              let exb2 : UInt64 := if x2 < y2 || ext2 < exb1 then 1 else 0
              let ext3 := x3 - y3
              let e3 := ext3 - exb2
              let exb3 : UInt64 := if x3 < y3 || ext3 < exb2 then 1 else 0
              let exmask : UInt64 := 0 - exb3
              let exa0 := m0 &&& exmask
              let exa1 := m1 &&& exmask
              let exa2 := m2 &&& exmask
              let exa3 := m3 &&& exmask
              let exr0 := e0 + exa0
              let exwc0 : UInt64 := if exr0 < e0 then 1 else 0
              let exwt1 := e1 + exa1
              let exr1 := exwt1 + exwc0
              let exwc1 : UInt64 := if exwt1 < e1 || exr1 < exwt1 then 1 else 0
              let exwt2 := e2 + exa2
              let exr2 := exwt2 + exwc1
              let exwc2 : UInt64 := if exwt2 < e2 || exr2 < exwt2 then 1 else 0
              let exr3 := e3 + exa3 + exwc2
              go fuel m0 m1 m2 m3 d0 d1 d2 d3 v0 v1 v2 v3 exr0 exr1 exr2 exr3 y0 y1 y2 y3
            else
              let w0 := v0 - u0
              let vwb0 : UInt64 := if v0 < u0 then 1 else 0
              let vwt1 := v1 - u1
              let w1 := vwt1 - vwb0
              let vwb1 : UInt64 := if v1 < u1 || vwt1 < vwb0 then 1 else 0
              let vwt2 := v2 - u2
              let w2 := vwt2 - vwb1
              let vwb2 : UInt64 := if v2 < u2 || vwt2 < vwb1 then 1 else 0
              let w3 := v3 - u3 - vwb2
              let f0 := y0 - x0
              let fyb0 : UInt64 := if y0 < x0 then 1 else 0
              let fyt1 := y1 - x1
              let f1 := fyt1 - fyb0
              let fyb1 : UInt64 := if y1 < x1 || fyt1 < fyb0 then 1 else 0
              let fyt2 := y2 - x2
              let f2 := fyt2 - fyb1
              let fyb2 : UInt64 := if y2 < x2 || fyt2 < fyb1 then 1 else 0
              let fyt3 := y3 - x3
              let f3 := fyt3 - fyb2
              let fyb3 : UInt64 := if y3 < x3 || fyt3 < fyb2 then 1 else 0
              let fymask : UInt64 := 0 - fyb3
              let fya0 := m0 &&& fymask
              let fya1 := m1 &&& fymask
              let fya2 := m2 &&& fymask
              let fya3 := m3 &&& fymask
              let fyr0 := f0 + fya0
              let fywc0 : UInt64 := if fyr0 < f0 then 1 else 0
              let fywt1 := f1 + fya1
              let fyr1 := fywt1 + fywc0
              let fywc1 : UInt64 := if fywt1 < f1 || fyr1 < fywt1 then 1 else 0
              let fywt2 := f2 + fya2
              let fyr2 := fywt2 + fywc1
              let fywc2 : UInt64 := if fywt2 < f2 || fyr2 < fywt2 then 1 else 0
              let fyr3 := f3 + fya3 + fywc2
              go fuel m0 m1 m2 m3 u0 u1 u2 u3 w0 w1 w2 w3 x0 x1 x2 x3 fyr0 fyr1 fyr2 fyr3

/-- The four 64-bit limbs of `x < 2²⁵⁶`, least significant first. -/
private def limbsOf (x : Nat) : UInt64 × UInt64 × UInt64 × UInt64 :=
  (x.toUInt64, (x >>> 64).toUInt64, (x >>> 128).toUInt64, (x >>> 192).toUInt64)

/-- The inverse of `a` modulo the odd `m < 2²⁵⁶`, `0` when there is none. -/
def inv (a m : Nat) : Nat :=
  let a := a % m
  if a == 0 then 0
  else
    let (m0, m1, m2, m3) := limbsOf m
    let (u0, u1, u2, u3) := limbsOf a
    match go 4096 m0 m1 m2 m3 u0 u1 u2 u3 m0 m1 m2 m3 1 0 0 0 0 0 0 0 with
    | some (x0, x1, x2, x3) =>
      let r := x0.toNat ||| x1.toNat <<< 64 ||| x2.toNat <<< 128 ||| x3.toNat <<< 192
      if a * r % m == 1 then r else invEuclid a m
    | none => invEuclid a m

end NearCrypto.ModInv
