: {"from": "alice.near", "method": "ft_transfer", "deposit": "1", "argsText": "{\"receiver_id\":\"bob.near\",\"amount\":\"1\",\"x\":.5}"}, "expect": "noCall"}, {"probe": true, "label": "num-minus", "call": {"from": "alice.near", "method": "ft_transfer", "deposit": "1", "argsText": "{\"receiver_id\":\"bob.near\",\"amount\":\"1\",\"x\":-}"}, "expect": "noCall"}, {"probe": true, "label": "num-1e", "call": {"from": "alice.near", "method": "ft_transfer", "deposit": "1", "argsText": "{\"receiver_id\":\"bob.near\",\"amount\":\"1\",\"x\":1e}"}, "expect": "noCall"}, {"probe": true, "label": "num-1E+5", "call": {"from": "alice.near", "method": "ft_transfer", "deposit": "1", "argsText": "{\"receiver_id\":\"bob.near\",\"amount\":\"1\",\"x\":1E+5}"}, "expect": "ok"}, {"probe": true, "label": "num--0.0e-0", "call": {"from": "alice.near", "method": "ft_transfer", "deposit": "1", "argsText": "{\"receiver_id\":\"bob.near\",\"amount\":\"1\",\"x\":-0.0e-0}"}, "expect": "ok"}, {"probe": true, "label": "num-plus", "call": {"from": "alice.near", "method": "ft_transfer", "deposit": "1", "argsText": "{\"receiver_id\":\"bob.near\",\"amount\":\"1\",\"x\":+1}"}, "expect": "noCall"}, {"probe": true, "label": "lit-tru", "call": {"from": "alice.near", "method": "ft_transfer", "deposit": "1", "argsText": "{\"receiver_id\":\"bob.near\",\"amount\":\"1\",\"x\":tru}"}, "expect": "noCall"}, {"probe": true, "label": "lit-True", "call": {"from": "alice.near", "method": "ft_transfer", "deposit": "1", "argsText": "{\"receiver_id\":\"bob.near\",\"amount\":\"1\",\"x\":True}"}, "expect": "noCall"}, {"probe": true, "label": "lit-nullx", "call": {"from": "alice.near", "method": "ft_transfer", "deposit": "1", "argsText": "{\"receiver_id\":\"bob.near\",\"amount\":\"1\",\"x\":nullx}"}, "expect": "noCall"}, {"probe": true, "label": "trailing-comma", "call": {"from": "alice.near", "method": "ft_transfer", "deposit": "1", "argsText": "{\"receiver_id\":\"bob.near\",\"amount\":\"1\",}"}, "expect": "noCall"}, {"probe": true, "label": "trailing-comma-ignored", "call": {"from": "alice.near", "method": "ft_transfer", "deposit": "1", "argsText": "{\"receiver_id\":\"bob.near\",\"amount\":\"1\",\"x\":[1,]}"}, "expect": "noCall"}, {"probe": true, "label": "nested-key-not-string", "call": {"from": "alice.near", "method": "ft_transfer", "deposit": "1", "argsText": "{\"receiver_id\":\"bob.near\",\"amount\":\"1\",\"x\":{1:2}}"}, "expect": "noCall"}, {"probe": true, "label": "key-not-string", "call": {"from": "alice.near", "method": "ft_transfer", "deposit": "1", "argsText": "{1:2,\"receiver_id\":\"bob.near\",\"amount\":\"1\"}"}, "expect": "noCall"}, {"probe": true, "label": "two-values", "call": {"from": "alice.near", "method": "ft_transfer", "deposit": "1", "argsText": "{\"receiver_id\":\"bob.near\",\"amount\":\"1\"} {}"}, "expect": "noCall"}, {"probe": true, "label": "balance-of-escaped", "call": {"from": "alice.near", "method": "ft_balance_of", "argsText": "{\"account_id\":\"bob.near\"}"}, "expect": "ok"}, {"probe": true, "label": "balance-of-array", "call": {"from": "alice.near", "method": "ft_balance_of", "argsText": "[\"bob.near\"]"}, "expect": "ok"}, {"probe": true, "label": "balance-of-array-extra", "call": {"from": "alice.near", "method": "ft_balance_of", "argsText": "[\"bob.near\",1]"}, "expect": "noCall"}, {"probe": true, "label": "utf16-escape-uppercase-hex", "call": {"from": "alice.near", "method": "ft_transfer", "deposit": "1", "argsText": "{\"receiver_id\":\"bob.near\",\"amount\":\"1\",\"memo\":\"\u00e9\ud83d\ude00\"}"}, "expect": "ok"}, {"probe": true, "label": "raw-del", "call": {"from": "alice.near", "method": "ft_transfer", "deposit": "1", "argsText": "{\"receiver_id\":\"bob.near\",\"amount\":\"1\",\"memo\":\"a\u007fb\"}"}, "expect": "ok"}, {"probe": true, "label": "raw-tab-in-string", "call": {"from": "alice.near", "method": "ft_transfer", "deposit": "1", "argsText": "{\"receiver_id\":\"bob.near\",\"amount\":\"1\",\"memo\":\"a\tb\"}"}, "expect": "noCall"}, {"probe": true