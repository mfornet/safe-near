(module
 (import "env" "promise_batch_create" (func $batch (param i64 i64) (result i64)))
 (import "env" "promise_batch_action_transfer" (func $transfer (param i64 i64)))
 (import "env" "panic" (func $panic))
 (memory 1)
 (data (i32.const 1024) "\01")
 (data (i32.const 0) "alice.near")
 (func (export "named") i64.const 10 i64.const 0 call $batch i64.const 1024 call $transfer)
 (data (i32.const 80) "abababababababababababababababababababababababababababababababab")
 (func (export "near") i64.const 64 i64.const 80 call $batch i64.const 1024 call $transfer)
 (data (i32.const 160) "0xabababababababababababababababababababab")
 (func (export "eth") i64.const 42 i64.const 160 call $batch i64.const 1024 call $transfer)
 (data (i32.const 240) "0sabababababababababababababababababababab")
 (func (export "deterministic") i64.const 42 i64.const 240 call $batch i64.const 1024 call $transfer)
 (data (i32.const 320) "gaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
 (func (export "near_lookalike") i64.const 64 i64.const 320 call $batch i64.const 1024 call $transfer)
 (data (i32.const 400) "0xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaag")
 (func (export "eth_lookalike") i64.const 42 i64.const 400 call $batch i64.const 1024 call $transfer)
 (data (i32.const 480) "0saaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaag")
 (func (export "deterministic_lookalike") i64.const 42 i64.const 480 call $batch i64.const 1024 call $transfer)
 (func (export "near_twice") (local i64) i64.const 64 i64.const 80 call $batch local.set 0 local.get 0 i64.const 1024 call $transfer local.get 0 i64.const 1024 call $transfer)
 (func (export "near_zero") i64.const 64 i64.const 80 call $batch i64.const 1040 call $transfer)
 (func (export "near_panic") i64.const 64 i64.const 80 call $batch i64.const 1024 call $transfer call $panic)
 (func (export "near_bad_index") i64.const 64 i64.const 80 call $batch drop i64.const 99 i64.const 1024 call $transfer)
 (func (export "near_bad_amount") i64.const 64 i64.const 80 call $batch i64.const -8 call $transfer)
 (func (export "named_bad_amount") i64.const 10 i64.const 0 call $batch i64.const -8 call $transfer)
)
