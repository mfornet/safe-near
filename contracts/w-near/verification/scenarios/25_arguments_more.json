[
  {"name": "arguments: struct forms, scalar wrappers, numbers and literals", "description": "Escaped and duplicate keys, the array form with missing, null and extra elements, U128 strings near from_str_radix's edges, account ids at 1 and 2 bytes and with escapes, invalid UTF-8 (overlong, encoded surrogates) in typed and ignored strings, malformed numbers and literals, trailing commas, empty and null input.", "state": {"accounts": {"alice.near": "100000000000000000000000000", "bob.near": "1000000000000000000000000", "aa": "3"}}, "blocks": [{"receipts": [{"probe": true, "label": "escaped-key", "call": {"from": "alice.near", "method": "ft_transfer", "deposit": "1", "argsText": "{\"receiver_id\":\"bob.near\",\"amount\":\"1\"}"}, "expect": "ok"}, {"probe": true, "label": "escaped-key-dup", "call": {"from": "alice.near", "method": "ft_transfer", "deposit": "1", "argsText": "{\"receiver_id\":\"bob.near\",\"receiver_id\":\"bob.near\",\"amount\":\"1\"}"}, "expect": "noCall"}, {"probe": true, "label": "array-missing-option", "call": {"from": "alice.near", "method": "ft_transfer", "deposit": "1", "argsText": "[\"bob.near\",\"1\"]"}, "expect": "noCall"}, {"probe": true, "label": "array-null-option", "call": {"from": "alice.near", "method": "ft_transfer", "deposit": "1", "argsText": "[\"bob.near\",\"1\",null]"}, "expect": "ok"}, {"probe": true, "label": "array-memo", "call": {"from": "alice.near", "method": "ft_transfer", "deposit": "1", "argsText": "[\"bob.near\",\"1\",\"hi\"]"}, "expect": "ok"}, {"probe": true, "label": "array-too-long", "call": {"from": "alice.near", "method": "ft_transfer", "deposit": "1", "argsText": "[\"bob.near\",\"1\",null,null]"}, "expect": "noCall"}, {"probe": true, "label": "tc-array", "call": {"from": "alice.near", "method": "ft_transfer_call", "deposit": "1", "argsText": "[\"bob.near\",\"1\",null,\"m\"]"}, "expect": "ok"}, {"probe": true, "label": "tc-msg-null", "call": {"from": "alice.near", "method": "ft_transfer_call", "deposit": "1", "argsText": "{\"receiver_id\":\"bob.near\",\"amount\":\"1\",\"msg\":null}"}, "expect": "noCall"}, {"probe": true, "label": "tc-msg-missing", "call": {"from": "alice.near", "method": "ft_transfer_call", "deposit": "1", "argsText": "{\"receiver_id\":\"bob.near\",\"amount\":\"1\"}"}, "expect": "noCall"}, {"probe": true, "label": "amount-plus-alone", "call": {"from": "alice.near", "method": "ft_transfer", "deposit": "1", "argsText": "{\"receiver_id\":\"bob.near\",\"amount\":\"+\"}"}, "expect": "noCall"}, {"probe": true, "label": "amount-empty", "call": {"from": "alice.near", "method": "ft_transfer", "deposit": "1", "argsText": "{\"receiver_id\":\"bob.near\",\"amount\":\"\"}"}, "expect": "noCall"}, {"probe": true, "label": "amount-minus", "call": {"from": "alice.near", "method": "ft_transfer", "deposit": "1", "argsText": "{\"receiver_id\":\"bob.near\",\"amount\":\"-1\"}"}, "expect": "noCall"}, {"probe": true, "label": "amount-space", "call": {"from": "alice.near", "method": "ft_transfer", "deposit": "1", "argsText": "{\"receiver_id\":\"bob.near\",\"amount\":\" 1\"}"}, "expect": "noCall"}, {"probe": true, "label": "amount-fullwidth", "call": {"from": "alice.near", "method": "ft_transfer", "deposit": "1", "argsText": "{\"receiver_id\":\"bob.near\",\"amount\":\"\uff11\"}"}, "expect": "noCall"}, {"probe": true, "label": "amount-2^128", "call": {"from": "alice.near", "method": "ft_transfer", "deposit": "1", "argsText": "{\"receiver_id\":\"bob.near\",\"amount\":\"340282366920938463463374607431768211456\"}"}, "expect": "noCall"}, {"probe": true, "label": "amount-plus-plus", "call": {"from": "alice.near", "method": "ft_transfer", "deposit": "1", "argsText": "{\"receiver_id\":\"bob.near\",\"amount\":\"++1\"}"}, "expect": "noCall"}, {"probe": true, "label": "amount-object", "call": {"from": "alice.near", "method": "ft_transfer", "deposit": "1", "argsText": "{\"receiver_id\":\"bob.near\",\"amount\":{\"0\":\"1\"}}"}, "expect": "noCall"}, {"probe": true, "label": "amount-array", "call": {"from"