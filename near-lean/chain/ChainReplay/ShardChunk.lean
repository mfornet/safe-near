import NearRuntime.ShardSink
import NearRuntime.QueueEncoding
import NearVM.TrieOverlay

/-! One shard's chunk, from the bandwidth scheduler to the outgoing receipts and the congestion
info it publishes. This is the part of `Runtime::apply` that surrounds receipt execution
(`runtime/runtime/src/lib.rs`: `run_bandwidth_scheduler`, `ReceiptSink::new`, `forward_from_buffer`,
the `forward_or_buffer_receipt` calls, `validate_apply_state_update`) with the scheduler, congestion
and sink of `NearRuntime`:

1. the scheduler runs on the previous scheduler state and the requests of all shards;
2. buffered receipts are forwarded as far as limits allow;
3. each receipt the chunk created for another shard (or this one) is forwarded or buffered, in order;
4. delayed queue changes, the allowed shard and the bandwidth requests give the published info.

Nothing generated by nearcore enters: the inputs are the congestion info and requests of the
previous height, the shard layout and the previous block hash. -/
namespace ChainReplay.ShardChunk

open Near Near.Sharding Near.Bandwidth Near.ShardSink Near.Congestion

/-- What a chunk is told about the network. The defaults are the single-shard reference layout. -/
structure Input where
  layout : ShardLayout := ShardLayout.single
  /-- `BlockCongestionInfo`: every shard's last info and missed chunk count, by shard id. -/
  congestion : List (Nat × ShardCongestion) := [(0, { info := {}, missedChunks := 0 })]
  /-- `BlockBandwidthRequests`: every shard's requests from the previous height. -/
  requests : List (Nat × List Request) := []
  /-- `prev_block_hash`: the scheduler's random seed. -/
  prevBlockHash : Bytes := List.replicate 32 0
  deriving Inhabited

/-- What the shard keeps between chunks beyond accounts and queues. -/
structure State where
  scheduler : Bandwidth.State := {}
  buffers : Buffers := {}

/-- The trie columns of the scheduler state and the outgoing buffers. -/
def State.entries (state : State) : Except String (List (Bytes × Bytes)) := do
  return state.scheduler.entries ++ (← state.buffers.entries)

/-- Every encoded runtime column contributes to canonical trie shape. Rebuild only at a chunk
boundary, which also starts an empty accounting cache. -/
def start (cfg : Wasm.Near.RuntimeConfig) (codes : List (String × Bytes))
    (context : QueueEncoding.Context) (state : ChainState) (shard : State) :
    Except String TrieOverlay.State := do
  TrieOverlay.start ((← QueueEncoding.encode state codes context (some cfg)) ++ (← shard.entries))

/-- A receipt the chunk sends: Borsh bytes and the congestion gas `compute_receipt_congestion_gas`
gives it. -/
structure Sent where
  bytes : Bytes
  gas : Nat

/-- Delayed queue movement of the chunk: gas and bytes of the receipts popped and pushed. -/
structure DelayedChange where
  addedGas : Nat := 0
  addedBytes : Nat := 0
  removedGas : Nat := 0
  removedBytes : Nat := 0

structure Outcome where
  state : State
  /-- `ApplyResult::outgoing_receipts`: buffered ones that fit, then new ones that fit. -/
  outgoing : List Bytes
  /-- `ApplyResult::congestion_info`. -/
  info : Info
  /-- `ApplyResult::bandwidth_requests`. -/
  requests : List Request
  /-- `bandwidth_scheduler_state_hash`. -/
  schedulerHash : Bytes
  /-- The bandwidth the scheduler granted, by shard ids: (sender, receiver, bytes). -/
  granted : List (Nat × Nat × Nat)

/-- The status the scheduler sees of a shard (`run_bandwidth_scheduler`). -/
def shardStatus (config : Config) (layout : ShardLayout) (c : ShardCongestion) : ShardStatus :=
  let control : Control := { config, info := c.info, missedChunks := c.missedChunks }
  { lastChunkMissing := c.missedChunks > 0
    allowedSenderIndex := layout.index? c.info.allowedShard
    isFullyCongested := Control.isFullyCongested control.level }

/-- `Runtime::apply` around the receipts: see the module comment. `shard` is this shard's id and
`height` the block height. -/
def finish (config : Config) (input : Input) (shard height : Nat) (previous : State)
    (sent : List Sent) (delayed : DelayedChange) : Except String Outcome := do
  let layout := input.layout
  let params := Params.protocol layout.numShards config.maxReceiptSize
  let status := input.congestion.map fun (id, c) => (id, shardStatus config layout c)
  let scheduled := schedule layout previous.scheduler params input.requests status input.prevBlockHash
  let some own := input.congestion.find? (·.1 == shard)
    | throw "the shard's own congestion info is absent (bootstrapping it is not represented)"
  let mut sink := Sink.create config layout shard own.2.info input.congestion scheduled previous.buffers
  sink ← sink.forwardAll
  for item in sent do
    sink ← sink.forwardOrBuffer item.bytes item.gas
  let info ← (← (← (← sink.info.addDelayedGas delayed.addedGas).removeDelayedGas delayed.removedGas
    ).addReceiptBytes delayed.addedBytes).removeReceiptBytes delayed.removedBytes
  let some index := layout.index? shard | throw "the shard is not in the layout"
  let info := info.finalizeAllowedShard shard layout.shardIds ((height + index) % 2 ^ 64)
  let granted := (List.range layout.numShards).flatMap fun s =>
    (List.range layout.numShards).filterMap fun r =>
      let bytes := scheduled.grant s r
      if bytes == 0 then none else some ((layout.id? s).getD 0, (layout.id? r).getD 0, bytes)
  return { state := { scheduler := scheduled.state, buffers := sink.buffers }
           outgoing := sink.outgoing, info, requests := sink.requests params
           schedulerHash := Sha256.hash scheduled.state.toBorsh, granted }

end ChainReplay.ShardChunk
