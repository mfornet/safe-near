# Check every repository-owned Lake package against the root Lean version.
check-toolchains:
    python3 tools/check_lean_toolchains.py

# Check the compiled VM import graph for legacy interpreter and proof API dependencies.
vm-dependencies:
    python3 tools/check_vm_dependencies.py
    python3 tools/tests/check_vm_dependencies.py

# Check that contract verification never reaches the node and our Lean has no native code.
node-isolation:
    python3 tools/check_node_isolation.py
    python3 -m unittest tools/tests/test_node_isolation.py

# Time a clean wNEAR verification build against this machine's baseline (--record sets it).
[positional-arguments]
verification-buildtime *options:
    python3 tools/verification_buildtime.py "$@"

# The node's M0 gates: source isolation, compiled VM closure and verification build time.
node-guardrails: node-isolation vm-dependencies verification-buildtime

# Build the pure-Lean crypto package (notes/design/NEAR_NODE.md, M2) and its test executables.
crypto-build:
    cd near-lean/crypto && lake build NearCrypto crypto-conformance crypto-differential --wfail

# M2: every hash and Ed25519 vector of the oracle against the Spec and the Impl, then Spec against Impl on seeded random inputs.
crypto-tests: crypto-build
    cd near-lean/crypto && ./.lake/build/bin/crypto-conformance fixtures
    cd near-lean/crypto && ./.lake/build/bin/crypto-differential

# Build the NEAR node (notes/design/NEAR_NODE.md) and its executables.
node-build:
    cd near-lean/node && lake build NearNode near-lean-node node-bench node-conformance-types node-trie-tests node-store-tests node-state-roots --wfail

# M1: the Borsh codecs of every near-primitives type against the committed nearcore oracle fixtures.
[positional-arguments]
node-conformance-types *options: node-build
    near-lean/node/.lake/build/bin/node-conformance-types "$@"

# M4: the trie Impl against the Spec (NearInterface.TrieConstruction) on seeded random entry sets and
# updates; the optional argument is the number of cases.
[positional-arguments]
node-trie-tests *options: node-build
    near-lean/node/.lake/build/bin/node-trie-tests "$@"

# M4: the state roots of the 436 corpus chunks through the Lean trie, from the recorded `stateDiff` and
# from Lean's own replay of each chunk (about 15 minutes on four cores; `--no-replay` skips the replay).
[positional-arguments]
node-state-roots *options: node-build
    cd near-lean/chain && lake build registered-replay --wfail
    python3 tools/localnet/state_roots.py "$@"

# M4: the persistent store: unit tests, then a restart and kill-in-the-middle test on the corpus tries.
node-store-tests: node-build
    python3 tools/localnet/state_roots.py --no-replay --cases-only --work near-lean/node/.lake/state-roots-cases
    near-lean/node/.lake/build/bin/node-store-tests near-lean/node/.lake/state-roots-cases

# M4: the same trie workload with nearcore's own near-store (needs the pinned checkout in
# tools/localnet/.nearcore, see `just corpus-build`); add --memtrie for the in-memory trie.
[positional-arguments]
node-trie-native-bench *options:
    cd tools/node-conformance/native-trie && cargo run --release --bin native-trie-bench -- "$@"

# Run the node benchmarks (`crypto/` and `sha256` for M2); options are --filter SUBSTRING and --out FILE.
[positional-arguments]
node-bench *options: node-build
    near-lean/node/.lake/build/bin/node-bench "$@"

# Check Lean source style with the pinned Mathlib text-based linters.
lean-lint:
    python3 tools/lean_style.py

# Apply validated syntax formatting to package sources (optional file selection).
[positional-arguments]
lean-format *files:
    python3 tools/lean_format.py --fix "$@"

# Preview syntax-formatting changes without writing source (optional file selection).
[positional-arguments]
lean-format-check *files:
    python3 tools/lean_format.py --check "$@"

# Show syntax-formatting changes as a patch without writing source.
[positional-arguments]
lean-format-diff *files:
    python3 tools/lean_format.py --diff "$@"

# Apply Mathlib's automatic text-style fixes, then check remaining findings.
lean-style-fix:
    python3 tools/lean_style.py --fix

# Run the WebAssembly spec testsuite (optional .wast name filter).
wasm-test pattern="":
    just --justfile near-lean/wasm/justfile testsuite {{quote(pattern)}}

# Show the committed Wasm report's totals and unsupported features.
wasm-summary:
    just --justfile near-lean/wasm/justfile testsuite-summary

# Regenerate the committed Wasm coverage report with the pinned wasm-tools.
wasm-report:
    just --justfile near-lean/wasm/justfile testsuite-report



# Audit a Lake package's transitive axioms; add --allow-sorry for open specs.
[positional-arguments]
audit package *args:
    python3 tools/axiom-audit.py --report {{quote("audit/" + replace(package, "/", "-") + ".json")}} "$@"

# Download accounts at one finalized block; options include --block and --rpc.
[positional-arguments]
snapshot output +accounts_and_options:
    python3 tools/near_snapshot.py "$@"

# Run offline regression tests for repository tools.
tools-test:
    python3 -m unittest discover -s tools/tests -v
    python3 -m unittest discover -s tools/runtime-conformance -p 'test_*.py' -v

# The inexpensive automatic CI gate: no Lean downloads or native builds.
ci-check: check-toolchains node-isolation tools-test

# List the periodic-check sections with changes since their last check (see reports/periodic/LEDGER.json).
periodic-due:
    python3 tools/periodic_check.py --due

# Preview every expensive periodic check without running or downloading anything.
periodic-check-plan:
    python3 tools/periodic_check.py --plan

# Run the former heavy CI suites locally; keep full logs/timings under audit/periodic/.
periodic-check nearcore:
    python3 tools/periodic_check.py --nearcore {{quote(nearcore)}}

# Run all executable suites: NEAR scenarios, official Wasm tests and strict VM conformance.
test-all: check-toolchains tools-test near-test chain-replay-test runtime-adapter-test wasm-test near-conformance crypto-tests node-conformance-types

# Audit all core Lean packages.
audit-all:
    python3 tools/tests/check_axiom_audit.py
    @for package in wasm wasm-logic interface vm runtime chain crypto; do \
        python3 tools/axiom-audit.py near-lean/"$package" --report audit/"$package".json; \
    done

# Run executable suites, source checks, core axiom audits and contract builds.
check: test-all vm-dependencies lean-lint audit-all build-all
    python3 tools/tests/check_lean_style.py
    python3 tools/tests/check_lean_format.py

# Compare VM executors on calls seeded from a complete captured account snapshot.
[positional-arguments]
snapshot-vm snapshot account scenario +options:
    python3 tools/snapshot_vm.py "$@"

# Build the pinned trie-backed nearcore Runtime::apply reference (cold native build).
[positional-arguments]
chain-reference-build *options:
    python3 tools/chain-conformance/prepare.py "$@"

# Smoke-test the native apply reference and save raw-state evidence; no Lean comparison yet.
[positional-arguments]
chain-reference-test *options:
    python3 tools/chain-conformance/probe.py "$@"

# Exercise trusted JSON chain replay, complete-state continuation and rejection paths.
chain-replay-test:
    cd near-lean/chain && lake build registered-replay chain-replay
    python3 tools/chain-conformance/test_replay.py

# Compare transfer/creation gas settlement with the built native oracle; scope is not general conformance.
[positional-arguments]
chain-gas-test *options:
    cd near-lean/chain && lake build registered-replay chain-replay
    python3 tools/chain-conformance/gas_probe.py "$@"

# Prepare a synthetic native/Lean chain genesis from complete captured accounts.
[positional-arguments]
chain-import snapshot destination *options:
    cd near-lean/chain && lake build registered-replay chain-replay
    python3 tools/chain-conformance/import_snapshot.py "$@"

# Check captured-state imports and native transaction signing (built native oracle required).
chain-import-test:
    cd near-lean/chain && lake build registered-replay chain-replay
    python3 tools/chain-conformance/test_snapshot_import.py

# Compare every represented field in one imported native/Lean chain fixture.
[positional-arguments]
chain-compare fixture *options:
    cd near-lean/chain && lake build registered-replay chain-replay
    python3 tools/chain-conformance/compare_fixture.py "$@"

# Compare native contract calls, callbacks and exact storage gas across 53 cases.
chain-contract-test:
    cd near-lean/chain && lake build registered-replay chain-replay
    python3 tools/chain-conformance/test_contract_comparison.py

# Compare shared chunk cache, commit/rollback, complete state and scheduler inputs.
chain-chunk-storage-test:
    cd near-lean/chain && lake build registered-replay chain-replay
    python3 tools/chain-conformance/test_chunk_storage_accounting.py

# Compare every field across the full contract corpus.
[positional-arguments]
chain-contract-probe *options:
    cd near-lean/chain && lake build registered-replay chain-replay
    python3 tools/chain-conformance/contract_probe.py "$@"

# Compare signed V0/V1 nonce modes, protocol gates and rejected transaction batches.
chain-version-test:
    cd near-lean/chain && lake build registered-replay chain-replay
    python3 tools/chain-conformance/test_transaction_versions.py

# Compare administrative actions, structured failures and rollback with native apply.
chain-action-test:
    cd near-lean/chain && lake build registered-replay chain-replay
    python3 tools/chain-conformance/test_action_comparison.py

# Compare restricted-key authorization, detailed errors and failure precedence.
chain-permission-test:
    cd near-lean/chain && lake build registered-replay chain-replay
    python3 tools/chain-conformance/test_permission_comparison.py

# Compare stateless action admission, boundaries and actual deployment-byte binding.
chain-validation-test:
    cd near-lean/chain && lake build registered-replay chain-replay
    python3 tools/chain-conformance/test_action_validation.py

# Compare native Borsh widths, signature gates and transaction-size boundaries.
chain-size-test:
    cd near-lean/chain && lake build registered-replay chain-replay
    python3 tools/chain-conformance/test_transaction_size.py

# Compare pure staking-key eligibility and native admission/rollback behavior.
chain-staking-test:
    cd near-lean/runtime && lake build staking-key-replay
    cd near-lean/chain && lake build registered-replay chain-replay
    python3 tools/chain-conformance/test_staking_key.py

# Compare native canonical trie paths and cache counts; does not inject gas into runtime execution.
[positional-arguments]
chain-trie-compare request *options:
    cd near-lean/runtime && lake build trie-replay --wfail
    python3 tools/chain-conformance/trie_probe.py "$@"

# Check trie Borsh decoding, path selection, value dereferences and cross-role cache aliases.
chain-trie-test:
    cd near-lean/runtime && lake build trie-replay --wfail
    python3 tools/chain-conformance/test_trie_accounting.py
    python3 tools/chain-conformance/test_trie_updates.py

# Compare typed model accounts/keys/code/storage to native Borsh and canonical trie objects.
chain-state-encoding-test:
    cd near-lean/chain && lake build registered-replay state-encode --wfail
    python3 tools/chain-conformance/test_state_encoding.py

# Check native receipt ancestry, callback data IDs and typed receipt Borsh bytes.
chain-receipt-encoding-test:
    cd near-lean/chain && lake build registered-replay receipt-encode chain-replay --wfail
    python3 tools/chain-conformance/test_receipt_encoding.py

# Check callback/delayed queue records, storage wrappers and real runtime queue bytes.
chain-queue-encoding-test:
    cd near-lean/chain && lake build registered-replay state-encode receipt-encode chain-replay --wfail
    python3 tools/chain-conformance/test_queue_encoding.py

# Check typed transaction bodies/hashes and admitted-prefix receipt registration.
chain-transaction-encoding-test:
    cd near-lean/chain && lake build registered-replay transaction-replay state-encode chain-replay --wfail
    python3 tools/chain-conformance/test_transaction_encoding.py

# Preserve persistent FIFO when new local and incoming work is deferred.
chain-delayed-order-test:
    cd near-lean/chain && lake build registered-replay chain-replay --wfail
    python3 tools/chain-conformance/test_delayed_local_order.py

# Register actual VM births and persistent queue context during trusted block replay.
chain-receipt-registry-test:
    cd near-lean/chain && lake build registered-replay chain-replay --wfail
    python3 tools/chain-conformance/test_receipt_registry.py

# Observe native action-derived randomness through contract execution.
chain-action-randomness-test:
    cd near-lean/chain && lake build registered-replay chain-replay --wfail
    python3 tools/chain-conformance/test_action_randomness.py

# Exercise the default imported-fixture identity, seed and raw-byte comparison path.
chain-registered-comparison-test:
    cd near-lean/chain && lake build chain-replay registered-replay --wfail
    python3 tools/chain-conformance/test_registered_comparison.py

# Build neard (release, pinned source), the corpus exporter and the oracle checker. Cold build: about 20 minutes.
[positional-arguments]
corpus-build *options:
    python3 tools/localnet/build.py "$@"

# Run a fresh localnet (single | sharded), drive the deterministic workload, stop it and export raw bundles.
[positional-arguments]
corpus-generate topology *options:
    python3 tools/localnet/generate.py "$@"

# Select a covering subset of the raw bundles of both topologies and pack it into near-lean/chain/corpus.
corpus-pack *options:
    python3 tools/localnet/corpus.py build --raw single=tools/localnet/data/single/raw --raw sharded=tools/localnet/data/sharded/raw {{options}}

# Oracle self-check: re-apply every corpus chunk with the pinned nearcore Runtime::apply (needs corpus-build).
[positional-arguments]
corpus-selfcheck *chunks:
    python3 tools/localnet/corpus.py check "$@"

# Replay the real-chunk corpus through the Lean runtime; exits 0 only when every chunk matches nearcore bit for bit.
chain-replay-corpus:
    cd near-lean/chain && lake build registered-replay --wfail
    python3 tools/localnet/replay_corpus.py

# The same replay, always exit 0: prints the status and reason table that is the M3 work list.
chain-replay-corpus-report:
    cd near-lean/chain && lake build registered-replay --wfail
    python3 tools/localnet/replay_corpus.py --report
