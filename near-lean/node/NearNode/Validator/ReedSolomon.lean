/-!
# Reed-Solomon erasure coding over GF(2^8)

`reed-solomon-erasure` 6.0.0 (`galois_8`), as `near-primitives` `reed_solomon.rs` uses it for chunk
bodies, state witnesses and contract deploys.

* **Field.** The elements are bytes, addition is xor, and the field is generated by the polynomial
  29 (`x^8 + x^4 + x^3 + x^2 + 1`, 0x11d) with `x = 2` a generator (`build.rs`: `gen_log_table`).
  `Gf.mulSpec` multiplies with shifts and reductions; `Gf.mul` uses the log and exp tables of the
  crate. The two are checked equal on all 65536 pairs by the tests.
* **Code.** `build_matrix` is the Vandermonde matrix `V[r][c] = r^c` (`nth(r) = r`, `0^0 = 1`) of
  `total` rows and `data` columns times the inverse of its top `data` by `data` square, so the first
  `data` rows are the identity (systematic) and the other `parity` rows give the parity shards.
  Encoding is the product of those rows with the data shards. Decoding picks the first `data` shards
  present, inverts the matching rows and multiplies, then recomputes the missing parity shards. Both
  are determined by the field and the matrix, so the bytes do not depend on the order of the
  operations.
* **Wrapper** (`reed_solomon.rs`): `reed_solomon_encode` pads the Borsh bytes to `data_parts`
  parts of `ceil(len / data_parts)` bytes; `reed_solomon_decode` rebuilds and truncates to the
  encoded length (at most 512 MiB).

Errors are those of the crate (`Error::TooFewShardsPresent`, ...), as text.
-/

namespace Near.Node.ReedSolomon

/-- The generating polynomial of the field below the `x^8` term. -/
def polynomial : UInt16 :=
  29

namespace Gf

/-- Multiplication by shifting and reducing: the definition of the field. -/
def mulSpec (a b : UInt8) : UInt8 :=
  Id.run do
    let mut acc : UInt16 := 0
    let mut x : UInt16 := a.toUInt16
    let mut y : UInt16 := b.toUInt16
    for _ in [0:8] do
      if y &&& 1 == 1 then
        acc := acc ^^^ x
      x := x <<< 1
      if x &&& 0x100 != 0 then
        x := (x ^^^ 0x100) ^^^ polynomial
      y := y >>> 1
    return acc.toUInt8

/-- `gen_log_table`: `log[2^i] = i` for `i` in `0..255`. -/
def logTable : ByteArray :=
  Id.run do
    let mut t := ByteArray.mk (Array.replicate 256 0)
    let mut b : UInt16 := 1
    for i in [0:255] do
      t := t.set! b.toNat i.toUInt8
      b := b <<< 1
      if b >= 256 then
        b := (b - 256) ^^^ polynomial
    return t

/-- `gen_exp_table`: the antilogarithms, doubled so that a sum of two logs indexes it. -/
def expTable : ByteArray :=
  Id.run do
    let mut t := ByteArray.mk (Array.replicate 510 0)
    for i in [1:256] do
      let l := (logTable.get! i).toNat
      t := t.set! l i.toUInt8
      t := t.set! (l + 255) i.toUInt8
    return t

/-- Addition and subtraction. -/
@[inline]
def add (a b : UInt8) : UInt8 :=
  a ^^^ b

/-- Multiplication (`galois_8::mul`). -/
def mul (a b : UInt8) : UInt8 :=
  if a == 0 || b == 0 then 0
  else expTable.get! ((logTable.get! a.toNat).toNat + (logTable.get! b.toNat).toNat)

/-- Division (`galois_8::div`); a zero divisor is an error in the crate (a panic), here `0`. -/
def div (a b : UInt8) : UInt8 :=
  if a == 0 || b == 0 then 0
  else
    let d := (logTable.get! a.toNat).toNat + 255 - (logTable.get! b.toNat).toNat
    expTable.get! (if d >= 255 then d - 255 else d)

/-- `a^n` (`galois_8::exp`): `a^0 = 1` even for `a = 0`. -/
def exp (a : UInt8) (n : Nat) : UInt8 :=
  if n == 0 then 1
  else if a == 0 then 0 else expTable.get! ((logTable.get! a.toNat).toNat * n % 255)

/-- The 256 products of `c` with every byte. -/
def mulRow (c : UInt8) : ByteArray :=
  ByteArray.mk ((Array.range 256).map fun i => mul c i.toUInt8)

end Gf

/-- A matrix over the field, row-major. -/
structure Matrix where
  rows : Nat
  cols : Nat
  data : ByteArray

namespace Matrix

def zero (rows cols : Nat) : Matrix :=
  ⟨rows, cols, ByteArray.mk (Array.replicate (rows * cols) 0)⟩

def identity (n : Nat) : Matrix :=
  Id.run do
    let mut m := zero n n
    for i in [0:n] do
      m := { m with data := m.data.set! (i * n + i) 1 }
    return m

@[inline]
def get (m : Matrix) (r c : Nat) : UInt8 :=
  m.data.get! (r * m.cols + c)

@[inline]
def set (m : Matrix) (r c : Nat) (v : UInt8) : Matrix :=
  { m with data := m.data.set! (r * m.cols + c) v }

/-- `Matrix::vandermonde`: `result[r][c] = r^c`. -/
def vandermonde (rows cols : Nat) : Matrix :=
  Id.run do
    let mut m := zero rows cols
    for r in [0:rows] do
      for c in [0:cols] do
        m := m.set r c (Gf.exp r.toUInt8 c)
    return m

def multiply (a b : Matrix) : Matrix :=
  Id.run do
    let mut m := zero a.rows b.cols
    for r in [0:a.rows] do
      for c in [0:b.cols] do
        let mut v : UInt8 := 0
        for i in [0:a.cols] do
          v := v ^^^ Gf.mul (a.get r i) (b.get i c)
        m := m.set r c v
    return m

/-- The rows `r0..r1` and columns `c0..c1`. -/
def subMatrix (m : Matrix) (r0 c0 r1 c1 : Nat) : Matrix :=
  Id.run do
    let mut out := zero (r1 - r0) (c1 - c0)
    for r in [r0:r1] do
      for c in [c0:c1] do
        out := out.set (r - r0) (c - c0) (m.get r c)
    return out

def swapRows (m : Matrix) (a b : Nat) : Matrix :=
  Id.run do
    let mut m := m
    if a != b then
      for c in [0:m.cols] do
        let x := m.get a c
        let y := m.get b c
        m := (m.set a c y).set b c x
    return m

/-- `Matrix::invert`: Gauss-Jordan on `[m | I]`. `none` for a singular matrix. -/
def invert (m : Matrix) : Option Matrix :=
  Id.run do
    let n := m.rows
    -- the augmented matrix
    let mut w := zero n (2 * n)
    for r in [0:n] do
      for c in [0:n] do
        w := w.set r c (m.get r c)
      w := w.set r (n + r) 1
    for r in [0:n] do
      if w.get r r == 0 then
        for below in [r + 1:n] do
          if w.get below r != 0 then
            w := w.swapRows r below
            break
      if w.get r r == 0 then
        return none
      if w.get r r != 1 then
        let scale := Gf.div 1 (w.get r r)
        for c in [0:2 * n] do
          w := w.set r c (Gf.mul scale (w.get r c))
      for below in [r + 1:n] do
        if w.get below r != 0 then
          let scale := w.get below r
          for c in [0:2 * n] do
            w := w.set below c (w.get below c ^^^ Gf.mul scale (w.get r c))
    for d in [0:n] do
      for above in [0:d] do
        if w.get above d != 0 then
          let scale := w.get above d
          for c in [0:2 * n] do
            w := w.set above c (w.get above c ^^^ Gf.mul scale (w.get d c))
    return some (w.subMatrix 0 n n (2 * n))

end Matrix

/-- A code with `data` data shards and `parity` parity shards. -/
structure Code where
  data : Nat
  parity : Nat
  /-- `build_matrix`: `total` rows, the first `data` of them the identity. -/
  matrix : Matrix

/-- `ReedSolomon::new`. -/
def Code.new (data parity : Nat) : Except String Code := do
  if data == 0 then
    throw "TooFewDataShards"
  if parity == 0 then
    throw "TooFewParityShards"
  if data + parity > 256 then
    throw "TooManyShards"
  let total := data + parity
  let v := Matrix.vandermonde total data
  let top := v.subMatrix 0 0 data data
  match top.invert with
  | some inv =>
    pure ⟨data, parity, v.multiply inv⟩
  | none =>
    throw "SingularMatrix"

def Code.total (c : Code) : Nat :=
  c.data + c.parity

/-- The row `row` of the matrix applied to `shards` (all of one length): `sum_j matrix[row][j] * shards[j]`. -/
private def combine (row : Nat) (m : Matrix) (shards : Array ByteArray) (len : Nat) : ByteArray :=
  Id.run do
    let mut out := ByteArray.mk (Array.replicate len 0)
    for j in [0:shards.size] do
      let coeff := m.get row j
      if coeff != 0 then
        let table := Gf.mulRow coeff
        let s := shards[j]!
        for b in [0:len] do
          out := out.set! b (out.get! b ^^^ table.get! (s.get! b).toNat)
    return out

/-- `encode`: the parity shards of `data` data shards of equal, non-zero length. -/
def Code.encode (c : Code) (shards : Array ByteArray) : Except String (Array ByteArray) := do
  if shards.size != c.data then
    throw "TooFewShards"
  let len := shards[0]!.size
  if len == 0 then
    throw "EmptyShard"
  if shards.any (·.size != len) then
    throw "IncorrectShardSize"
  let mut parity := #[]
  for i in [0:c.parity] do
    parity := parity.push (combine (c.data + i) c.matrix shards len)
  pure parity

/-- `reconstruct`: every missing shard (data and parity) from at least `data` present ones. All
present shards must have one length. -/
def Code.reconstruct (c : Code) (shards : Array (Option ByteArray)) :
    Except String (Array ByteArray) := do
  if shards.size != c.total then
    throw "TooFewShards"
  let mut lenSeen : Option Nat := none
  let mut present := 0
  for s in shards do
    if let some b := s then
      if b.size == 0 then
        throw "EmptyShard"
      present := present + 1
      match lenSeen with
      | some l =>
        if l != b.size then
          throw "IncorrectShardSize"
      | none =>
        lenSeen := some b.size
  if present == c.total then
    return shards.map (·.get!)
  if present < c.data then
    throw "TooFewShardsPresent"
  let len := lenSeen.get!
  -- the first `data` shards present
  let mut validIdx : Array Nat := #[]
  for i in [0:shards.size] do
    if validIdx.size < c.data && (shards[i]!).isSome then
      validIdx := validIdx.push i
  let mut sub := Matrix.zero c.data c.data
  for (idx, r) in validIdx.toList.zipIdx do
    for col in [0:c.data] do
      sub := sub.set r col (c.matrix.get idx col)
  let some decode := sub.invert | throw "SingularMatrix"
  let subShards := validIdx.map fun i => (shards[i]!).get!
  let mut out : Array ByteArray := Array.mkEmpty c.total
  for i in [0:c.data] do
    match shards[i]! with
    | some b =>
      out := out.push b
    | none =>
      out := out.push (combine i decode subShards len)
  for i in [c.data:c.total] do
    match shards[i]! with
    | some b =>
      out := out.push b
    | none =>
      out := out.push (combine i c.matrix (out.extract 0 c.data) len)
  pure out

/-! ### `near-primitives` `reed_solomon.rs` -/

/-- `reed_solomon_part_length`. -/
def partLength (encodedLength dataParts : Nat) : Nat :=
  (encodedLength + dataParts - 1) / dataParts

/-- `reed_solomon_num_data_parts(total, ratio)`: `max(trunc(total * ratio), 1)` in `f64`. -/
def numDataParts (total : Nat) (ratio : Float) : Nat :=
  max (total.toFloat * ratio).toUInt64.toNat 1

/-- The ratio of data parts of state witnesses and contract deploys. -/
def witnessRatio : Float :=
  0.6

/-- `MAX_ENCODED_LENGTH`: 512 MiB. -/
def maxEncodedLength : Nat :=
  512 * 1024 * 1024

/-- `reed_solomon_encode` on bytes that are already the Borsh encoding: the `data + parity` parts and
the encoded length. -/
def encodeBytes (c : Code) (bytes : ByteArray) : Except String (Array ByteArray × Nat) := do
  let encodedLength := bytes.size
  let partLen := partLength encodedLength c.data
  let padded := bytes ++ ByteArray.mk (Array.replicate (c.data * partLen - encodedLength) 0)
  let mut dataParts : Array ByteArray := #[]
  for i in [0:c.data] do
    dataParts := dataParts.push (padded.extract (i * partLen) ((i + 1) * partLen))
  let parity ← c.encode dataParts
  pure (dataParts ++ parity, encodedLength)

/-- `reed_solomon_decode`, up to the Borsh decoding: the first `encodedLength` bytes of the data parts. -/
def decodeBytes (c : Code) (parts : Array (Option ByteArray)) (encodedLength : Nat) :
    Except String ByteArray := do
  if encodedLength > maxEncodedLength then
    throw "encoded length is too large"
  let full ← c.reconstruct parts
  let mut buf := ByteArray.empty
  for p in full do
    let remaining := encodedLength - buf.size
    let take := min remaining p.size
    buf := buf ++ p.extract 0 take
  pure buf

/-- `ReedSolomonEncoder`: `none` for one part, which is not erasure coded. -/
structure Encoder where
  total : Nat
  code : Option Code

/-- `ReedSolomonEncoder::new(total_parts, ratio)`. -/
def Encoder.new (total : Nat) (ratio : Float) : Except String Encoder := do
  if total > 1 then
    let d := numDataParts total ratio
    pure ⟨total, some (← Code.new d (total - d))⟩
  else
    pure ⟨total, none⟩

def Encoder.dataParts (e : Encoder) : Nat :=
  match e.code with
  | some c => c.data
  | none => 1

/-- `ReedSolomonEncoder::encode` of bytes (the Borsh encoding, or what `serialize_single_part` gives). -/
def Encoder.encode (e : Encoder) (bytes : ByteArray) : Except String (Array ByteArray × Nat) :=
  match e.code with
  | some c => encodeBytes c bytes
  | none => pure (#[bytes], bytes.size)

end Near.Node.ReedSolomon
