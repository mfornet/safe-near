(module
  (import "env" "validator_stake" (func $stake (param i64 i64 i64)))
  (import "env" "validator_total_stake" (func $total (param i64)))
  (import "env" "value_return" (func $return (param i64 i64)))
  (memory 1)
  (data (i32.const 0) "alice.near")
  (data (i32.const 16) "bob.near")
  (data (i32.const 32) "carol.near")
  (data (i32.const 48) "\ff\fe")
  (data (i32.const 56) "A!")
  ;; Write a stake at 128 and return those 16 bytes.
  (func $back i64.const 16 i64.const 128 call $return)
  (func (export "alice") i64.const 10 i64.const 0 i64.const 128 call $stake call $back)
  (func (export "bob") i64.const 8 i64.const 16 i64.const 128 call $stake call $back)
  (func (export "carol") i64.const 10 i64.const 32 i64.const 128 call $stake call $back)
  (func (export "total") i64.const 128 call $total call $back)
  (func (export "bad_utf8") i64.const 2 i64.const 48 i64.const 128 call $stake)
  (func (export "invalid") i64.const 2 i64.const 56 i64.const 128 call $stake)
  (func (export "read_oob") i64.const 10 i64.const 68719476720 i64.const 128 call $stake)
  (func (export "bad_register") i64.const -1 i64.const 7 i64.const 128 call $stake)
  (func (export "write_oob") i64.const 10 i64.const 0 i64.const 68719476720 call $stake)
  (func (export "total_write_oob") i64.const 68719476720 call $total)
)
