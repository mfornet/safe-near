# Check/apply the public repository's approval gate (requires authenticated gh).
ci-approval-check:
    python3 tools/actions_approval.py

ci-approval-apply:
    python3 tools/actions_approval.py --apply

# Check every repository-owned Lake package against the root Lean version.
check-toolchains:
    python3 tools/check_lean_toolchains.py
    python3 tools/check_nearcore_pin.py

# Check that no module imports a whole package (Wasm, NearVM, NearRuntime, NearChain) and so builds its proofs.
umbrella-imports:
    python3 tools/check_umbrella_imports.py

# Check the compiled VM import graph for legacy interpreter and proof API dependencies.
vm-dependencies:
    python3 tools/check_vm_dependencies.py
    python3 tools/tests/check_vm_dependencies.py

# Check that contract verification never reaches the node and our Lean has no native code.
node-isolation:
    python3 tools/check_node_isolation.py
    python3 -m unittest tools/tests/test_node_isolation.py

# Time a clean wNEAR verification build against this machine's baseline (--record sets it).
[positional-arguments]
verification-buildtime *options:
    python3 tools/verification_buildtime.py "$@"

# The node's M0 gates: source isolation, compiled VM closure and verification build time.
node-guardrails: node-isolation vm-dependencies verification-buildtime

# Build the pure-Lean crypto package (notes/design/NEAR_NODE.md, M2) and its test executables.
crypto-build:
    cd near-lean/crypto && lake build NearCrypto crypto-conformance crypto-differential --wfail

# M2: every hash and Ed25519 vector of the oracle against the Spec and the Impl, then Spec against Impl on seeded random inputs.
crypto-tests: crypto-build
    cd near-lean/crypto && ./.lake/build/bin/crypto-conformance fixtures
    cd near-lean/crypto && ./.lake/build/bin/crypto-differential

# Build the NEAR node (notes/design/NEAR_NODE.md) and its executables.
node-build:
    cd near-lean/node && lake build NearNode near-lean-node node-bench node-conformance-types node-conformance-network node-conformance-sync node-conformance-validator node-sync-tests node-trie-tests node-store-tests node-state-roots node-chain-validate node-chain-apply node-validator-tests --wfail

# M1: the Borsh codecs of every near-primitives type against the committed nearcore oracle fixtures.
[positional-arguments]
node-conformance-types *options: node-build
    near-lean/node/.lake/build/bin/node-conformance-types "$@"

# M6: the peer protocol (protobuf messages and the Borsh types they carry) against the fixtures of nearcore's
# own network code (`safe-near-network-oracle`, see tools/localnet/network_oracle.rs); the optional argument is the
# fixtures directory.
[positional-arguments]
node-conformance-network *options: node-build
    near-lean/node/.lake/build/bin/node-conformance-network "$@"

# M7: zstd and the state parts of the trie against fixtures from the `zstd` crate and `near-store` at the pin
# (`just node-sync-oracle` writes them).
node-conformance-sync *options: node-build
    near-lean/node/.lake/build/bin/node-conformance-sync "$@"

# M8b: the validator's building blocks (Reed-Solomon, chunk production, signed messages, witness parts, zstd frames)
# against fixtures from the pinned crates (`just node-validator-oracle` writes them).
node-conformance-validator *options: node-build
    near-lean/node/.lake/build/bin/node-conformance-validator "$@"

# M8b: regenerate near-lean/node/fixtures/validator with near-primitives and reed-solomon-erasure at the pin, then check that
# the zstd crate decodes the frames the node writes (CI never builds this).
node-validator-oracle:
    cd tools/node-conformance && cargo run --release --locked --bin validator-fixtures -- ../../near-lean/node/fixtures/validator
    near-lean/node/.lake/build/bin/node-conformance-validator --write-zstd
    cd tools/node-conformance && cargo run --release --locked --bin validator-fixtures -- --verify-zstd ../../near-lean/node/fixtures/validator/zstd-stored.jsonl

# M7: regenerate near-lean/node/fixtures/state-sync with nearcore's own zstd and near-store (needs the clean nearcore
# checkout of `tools/localnet/build.py` and a Rust toolchain; CI never builds it).
node-sync-oracle:
    cd tools/node-conformance/native-trie && cargo run --release --bin state_sync_oracle -- ../../../near-lean/node/fixtures/state-sync

# M8c: Doomslug and the other state machines of a validator (the unit tests of doomslug.rs, ported).
node-validator-tests: node-build
    near-lean/node/.lake/build/bin/node-validator-tests

# M7: header sync, the sync block and the refusal of changed headers and bodies, on the in-memory network.
node-sync-tests: node-build
    python3 tools/localnet/sync_tests.py

# M4: the trie Impl against the Spec (NearInterface.TrieConstruction) on seeded random entry sets and
# updates; the optional argument is the number of cases.
[positional-arguments]
node-trie-tests *options: node-build
    near-lean/node/.lake/build/bin/node-trie-tests "$@"

# M4: the state roots of the 436 corpus chunks through the Lean trie, from the recorded `stateDiff` and
# from Lean's own replay of each chunk (about 15 minutes on four cores; `--no-replay` skips the replay).
[positional-arguments]
node-state-roots *options: node-build
    cd near-lean/chain && lake build registered-replay --wfail
    python3 tools/localnet/state_roots.py "$@"

# M5a: the block corpus (every block of both localnets, plus invalid variants with nearcore's own verdict) through
# the Lean header and block validator; exits 0 only when every block and variant agrees with nearcore.
chain-validate-corpus: node-build
    python3 tools/localnet/chain_validate.py

# M6: the Lean node as a peer of the pinned neard localnet: handshake, routing exchange, every block validated and
# applied, followed for a while; roots and ChunkExtra compared with neard's (see notes/design/NEAR_NODE.md, M6).
[positional-arguments]
localnet-peer *options: node-build
    python3 tools/localnet/peer_accept.py "$@"

# M7: the Lean node syncs a running neard localnet (headers, state of the shards over the peer-to-peer network, then blocks)
# and follows its head: within a few blocks of it, with every state root and ChunkExtra equal to neard's. The options
# include --topologies single sharded, --follow SECONDS, --full-workload (the heavy scenarios in the history) and
# --lightburst (a burst of heavy calls while following).
[positional-arguments]
localnet-follow *options: node-build
    python3 tools/localnet/follow_accept.py "$@"

# M8: the Lean node as a validator of a two-validator neard localnet that cannot finalize without it: blocks and chunks it
# produces are accepted by neard, state roots agree, finality advances, and the chain stops when the node does. The options
# include --duration SECONDS, --no-workload and --no-stall (see notes/design/NEAR_NODE.md, M8).
[positional-arguments]
localnet-validator *options: node-build
    python3 tools/localnet/validator_accept.py "$@"

# M10b: the fast VM engine (near-lean/fastvm) against the specification: random modules with the gas limits swept over
# every point of short runs and a sample of long ones, and the wNEAR contract of the VM's own test suite (needs
# `wasm-tools`). Options (for the random modules): --programs N, --seed N, --exhaustive N, --samples N.
[positional-arguments]
fastvm-differential *options:
    cd near-lean/fastvm && lake build fastvm-differential registered-replay-fast --wfail
    cd near-lean/fastvm && ./.lake/build/bin/fastvm-differential --configs ../vm/configs "$@"
    cd near-lean/fastvm && ./.lake/build/bin/fastvm-differential --configs ../vm/configs --probes 1
    cd near-lean/fastvm && ./.lake/build/bin/fastvm-differential --configs ../vm/configs --wnear ../vm/tests/fixtures/w_near.wat

# M10b: the 436 chunks of the M3 corpus replayed with the fast VM engine; all must pass, as with `chain-replay-corpus`.
chain-replay-corpus-fast:
    cd near-lean/fastvm && lake build registered-replay-fast --wfail
    python3 tools/localnet/replay_corpus.py --binary "$PWD/near-lean/fastvm/.lake/build/bin/registered-replay-fast" --audit audit/chain-replay-corpus-fast.json

# M10: the validator topology of localnet-validator under the full workload for a long window (default 3600 s), with
# a light burst every five minutes: state roots and hashes equal, finality advancing, lag bounded outside bursts, no
# disconnect, the Lean RPC answering, resident memory and store size sampled (slope reported). Options include
# --duration SECONDS, --burst-period SECONDS and --no-full-workload (see notes/design/NEAR_NODE.md, M10).
[positional-arguments]
localnet-soak *options: node-build
    python3 tools/localnet/soak.py "$@"

# M9b: the JSON-RPC conformance run: the same requests to neard and to the Lean node, field by field; transactions sent
# through the Lean RPC; a restart of the Lean validator. Options: `serve` (bring the topology up for manual use), `check`
# (run the request set against a topology that is up). See notes/design/NEAR_NODE.md, M9b.
[positional-arguments]
node-rpc-conformance *options: node-build
    python3 tools/localnet/rpc_conformance.py "$@"

# M5a: rebuild the block corpus from the localnet databases (needs `python3 tools/localnet/build.py --only
# safe-near-chain-export` and the databases of `just corpus-generate`).
[positional-arguments]
chain-corpus-generate *options:
    python3 tools/localnet/chain_corpus.py export "$@"
    python3 tools/localnet/chain_corpus.py pack
    python3 tools/localnet/chain_apply.py extras

# M5b: each localnet chain run from genesis by the Lean node, in two processes with the store between them:
# every EpochInfo computed (not given) and equal to nearcore's, the epoch-start validator account updates, every
# chunk applied by the runtime on the trie state with its ChunkExtra, incoming and outgoing receipts equal to
# nearcore's. Takes about an hour (the burst chunks run 300 Tgas in the Lean interpreter); `--no-restart` uses
# one process, `--topologies single` one chain; exits 0 only when all agree.
[positional-arguments]
chain-apply-corpus *options: node-build
    python3 tools/localnet/chain_apply.py run "$@"

# M4: the persistent store: unit tests, then a restart and kill-in-the-middle test on the corpus tries.
node-store-tests: node-build
    python3 tools/localnet/state_roots.py --no-replay --cases-only --work near-lean/node/.lake/state-roots-cases
    near-lean/node/.lake/build/bin/node-store-tests near-lean/node/.lake/state-roots-cases

# M4: the same trie workload with nearcore's own near-store (needs the pinned checkout in
# tools/localnet/.nearcore, see `just corpus-build`); add --memtrie for the in-memory trie.
[positional-arguments]
node-trie-native-bench *options:
    cd tools/node-conformance/native-trie && cargo run --release --bin native-trie-bench -- "$@"

# Run the node benchmarks (`crypto/` and `sha256` for M2); options are --filter SUBSTRING and --out FILE.
[positional-arguments]
node-bench *options: node-build
    near-lean/node/.lake/build/bin/node-bench "$@"

# Check Lean source style with the pinned Mathlib text-based linters.
lean-lint:
    python3 tools/lean_style.py

# Check style only on the Lean sources changed since a revision, as CI does on a pull request.
lean-lint-changed base="origin/main":
    python3 tools/lean_style.py --changed-from {{quote(base)}}

# Apply validated syntax formatting to package sources (optional file selection).
[positional-arguments]
lean-format *files:
    python3 tools/lean_format.py --fix "$@"

# Preview syntax-formatting changes without writing source (optional file selection).
[positional-arguments]
lean-format-check *files:
    python3 tools/lean_format.py --check "$@"

# Show syntax-formatting changes as a patch without writing source.
[positional-arguments]
lean-format-diff *files:
    python3 tools/lean_format.py --diff "$@"

# Apply Mathlib's automatic text-style fixes, then check remaining findings.
lean-style-fix:
    python3 tools/lean_style.py --fix

# Run the WebAssembly spec testsuite (optional .wast name filter).
wasm-test pattern="":
    just --justfile near-lean/wasm/justfile testsuite {{quote(pattern)}}

# Show the committed Wasm report's totals and unsupported features.
wasm-summary:
    just --justfile near-lean/wasm/justfile testsuite-summary

# Regenerate the committed Wasm coverage report with the pinned wasm-tools.
wasm-report:
    just --justfile near-lean/wasm/justfile testsuite-report



# Audit a Lake package's transitive axioms; add --allow-sorry for open specs.
[positional-arguments]
audit package *args:
    python3 tools/axiom-audit.py --report {{quote("audit/" + replace(package, "/", "-") + ".json")}} "$@"

# Download accounts at one finalized block; options include --block and --rpc.
[positional-arguments]
snapshot output +accounts_and_options:
    python3 tools/near_snapshot.py "$@"

# Run offline regression tests for repository tools.
tools-test:
    python3 tools/run_unittests.py -s tools/tests
    python3 tools/run_unittests.py -s tools/runtime-conformance -p 'test_*.py'

# The campaign driver (tools/campaign): `just campaign run --profile cheap`, status, results, auth, new, merge.
[positional-arguments]
campaign *args:
    python3 tools/campaign_driver.py "$@"

# The inexpensive automatic CI gate: no Lean downloads or native builds.
ci-check: check-toolchains node-isolation umbrella-imports tools-test

# List the periodic-check sections with changes since their last check (see reports/periodic/LEDGER.json).
periodic-due:
    python3 tools/periodic_check.py --due

# Preview every expensive periodic check without running or downloading anything.
periodic-check-plan:
    python3 tools/periodic_check.py --plan

# Run the former heavy CI suites locally; keep full logs/timings under audit/periodic/.
periodic-check nearcore:
    python3 tools/periodic_check.py --nearcore {{quote(nearcore)}}

# Run all executable suites: NEAR scenarios, official Wasm tests and strict VM conformance.
test-all: check-toolchains tools-test near-test chain-replay-test runtime-adapter-test wnear-scenarios wasm-test near-conformance crypto-tests node-conformance-types

# Audit all core Lean packages.
audit-all:
    python3 tools/tests/check_axiom_audit.py
    @for package in wasm wasm-logic interface vm runtime chain crypto sdk; do \
        python3 tools/axiom-audit.py near-lean/"$package" --report audit/"$package".json; \
    done

# Run executable suites, source checks, core axiom audits and contract builds.
check: test-all vm-dependencies lean-lint audit-all build-all
    python3 tools/tests/check_lean_style.py
    python3 tools/tests/check_lean_format.py

# Compare VM executors on calls seeded from a complete captured account snapshot.
[positional-arguments]
snapshot-vm snapshot account scenario +options:
    python3 tools/snapshot_vm.py "$@"

