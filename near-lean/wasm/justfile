# Wasm runtime. Run `just` to list recipes.
set shell := ["bash", "-euo", "pipefail", "-c"]

[private]
default:
    @just --list --unsorted

# Build the library and both executables.
build:
    lake build Wasm testsuite wasm

# Decode a module and print a summary: `just decode file.wasm`.
decode file:
    lake exe wasm decode {{ file }}

# Run the spec testsuite; optional substring filter on the .wast name.
testsuite pattern="":
    scripts/testsuite.sh {{ quote(pattern) }}

# Regenerate testsuite_report.txt (needs the pinned wasm-tools).
testsuite-report:
    scripts/testsuite-report.sh

# Totals per outcome from the committed report.
testsuite-summary:
    scripts/testsuite-summary.sh

# Remove build artefacts of this package.
clean:
    rm -rf .lake
