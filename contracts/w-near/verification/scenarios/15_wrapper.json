[
  {"name": "wrapper: the private check precedes the deposit check", "description": "near-sdk-core 3.1.0 method_wrapper: private check, deposit check, arguments, then state. A deposit on ft_resolve_transfer from another account reports 'is private'.", "state": {"accounts": {"alice.near": "1000000000000000000000000", "bob.near": "1000000000000000000000000", "0xabababababababababababababababababababab": "5", "0scdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcd": "5", "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb": "5"}}, "blocks": [{"receipts": [{"probe": true, "label": "private+deposit by bob", "call": {"from": "bob.near", "method": "ft_resolve_transfer", "args": {"sender_id": "alice.near", "receiver_id": "bob.near", "amount": "10"}, "deposit": "1", "results": ["failed"]}, "expect": "panic:Method ft_resolve_transfer is private"}, {"probe": true, "label": "private+deposit by self", "call": {"from": "wrap.near", "method": "ft_resolve_transfer", "args": {"sender_id": "alice.near", "receiver_id": "bob.near", "amount": "10"}, "deposit": "1", "results": ["failed"]}, "expect": "panic:Method ft_resolve_transfer doesn't accept deposi"}, {"probe": true, "label": "private bad args by bob", "call": {"from": "bob.near", "method": "ft_resolve_transfer", "args": {"x": 1}, "deposit": "1"}, "expect": "noCall"}, {"probe": true, "label": "view deposit", "call": {"from": "bob.near", "method": "ft_metadata", "deposit": "5"}, "expect": "ok"}, {"probe": true, "label": "new deposit", "call": {"from": "bob.near", "method": "new", "deposit": "5"}, "expect": "panic:Method new doesn't accept deposit"}, {"probe": true, "label": "new no deposit", "call": {"from": "bob.near", "method": "new"}, "expect": "panic:The contract has already been initialized"}]}]},
  {"name": "wrapper: order on an uninitialised contract", "description": "Private and deposit checks and argument parsing come before PanicOnDefault.", "state": null, "blocks": [{"receipts": [{"probe": true, "label": "private+deposit by bob uninit", "call": {"from": "bob.near", "method": "ft_resolve_transfer", "args": {"sender_id": "alice.near", "receiver_id": "bob.near", "amount": "10"}, "deposit": "1", "results": ["failed"]}, "expect": "panic:Method ft_resolve_transfer is private"}, {"probe": true, "label": "private by self uninit", "call": {"from": "wrap.near", "method": "ft_resolve_transfer", "args": {"sender_id": "alice.near", "receiver_id": "bob.near", "amount": "10"}, "results": ["failed"]}, "expect": "panic:The contract is not initialized"}, {"probe": true, "label": "transfer uninit deposit0", "call": {"from": "bob.near", "method": "ft_transfer", "args": {"receiver_id": "alice.near", "amount": "1"}}, "expect": "panic:The contract is not initialized"}, {"probe": true, "label": "view uninit", "call": {"from": "bob.near", "method": "ft_total_supply"}, "expect": "panic:The contract is not initialized"}, {"probe": true, "label": "withdraw bad args uninit", "call": {"from": "bob.near", "method": "near_withdraw", "args": {"amount": 5}, "deposit": "1"}, "expect": "noCall"}]}]}
